<script>
const DATA = {"GOL": {"currency": "BRL", "symbol": "R$", "fleet": 140, "bruta_6y": 180.14, "tat_6y": 45.63, "liq_6y": 134.5, "bruta_ann": 30.02, "fee_fixo": 0.6, "fee_fixo_breakdown": "R$ 200k diagnóstico (jun-jul/26) + R$ 400k implantação (ago-set/26)", "liq_2026": 8.05, "liq_2027_pct": 60, "liq_steady_pct": 80, "payback_months": 0.7, "qav_baseline": 5.91, "delta_per_005": 1.52, "co2": 76, "volume_6y": 30.5, "qav_hub_default": "GRU", "qav_value_default": "R$ 6,40 – 6,80/L", "qav_delta_default": "+100% vs Fev/2026", "qav_source_default": "Petrobras · Boletim Combustíveis Mai/26", "hubs": ["GRU", "CGH", "BSB", "GIG", "CNF"], "ebit_margin_base": 0.02, "revenue_usd_bb": 2.5, "language": "pt", "voice_text": "QAV já representa 45% dos custos operacionais das companhias aéreas brasileiras — qualquer economia tem impacto duplo.", "voice_name": "Juliano Noman", "voice_role": "Diretor · ABEAR", "voos_ano_2027": 294000, "voos_mes_medio_aeronave": 175, "load_factor": 0.82, "load_factor_label": "82%", "study_version": "v3 · Mai/26"}, "Azul": {"currency": "BRL", "symbol": "R$", "fleet": 160, "bruta_6y": 95.24, "tat_6y": 23.65, "liq_6y": 72.79, "bruta_ann": 17.0, "fee_fixo": 0.6, "fee_fixo_breakdown": "R$ 200k diagnóstico (jun/26) + R$ 400k implantação (jul-ago/26)", "liq_2026": 4.12, "liq_2027_pct": 60, "liq_steady_pct": 80, "payback_months": 1.4, "qav_baseline": 6.3, "delta_per_005": 0.8, "co2": 41, "volume_6y": 16.2, "qav_hub_default": "VCP", "qav_value_default": "R$ 6,30/L (Mai/26)", "qav_delta_default": "+105% vs base 2024", "qav_source_default": "Estudo TAT Azul v8 · malha real Jun-Ago/26", "hubs": ["VCP", "CNF", "REC", "POA", "CGB", "BEL", "CGH", "SDU", "GRU"], "ebit_margin_base": 0.025, "revenue_usd_bb": 3.0, "language": "pt", "voice_text": "QAV já representa 45% dos custos operacionais das companhias aéreas brasileiras — qualquer economia tem impacto duplo.", "voice_name": "Juliano Noman", "voice_role": "Diretor · ABEAR", "voos_ano_2027": 289781, "voos_mes_medio_aeronave