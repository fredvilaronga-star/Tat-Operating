<script>
// Dados de sensibilidade ano a ano
const DATA = {
    'GOL':    { vol: [1.55, 5.12, 5.48, 5.82, 6.15, 6.37], pct: [0.15, 0.35, 0.15, 0.15, 0.15, 0.15] },
    'Azul':   { vol: [0.92, 2.75, 2.91, 3.07, 3.22, 3.38], pct: [0.15, 0.35, 0.15, 0.15, 0.15, 0.15] },
    'TAP':    { vol: [0.49, 2.95, 3.10, 3.27, 3.42, 3.59], pct: [0.15, 0.35, 0.15, 0.15, 0.15, 0.15] },
    'Etihad': { vol: [0.46, 6.90, 7.46, 8.05, 8.70, 9.39], pct: [0.20, 0.40, 0.20, 0.20, 0.20, 0.20] },
};

const SYM = { 'GOL': 'R$', 'Azul': 'R$', 'TAP': '€', 'Etihad': 'US$' };
const ANOS = [2026, 2027, 2028, 2029, 2030, 2031];
let currentDelta = 0.05;
let currentSign = 1;

function fmt(val, sym) {
    const abs = Math.abs(val);
    const sign = val < 0 ? '−' : '';
    if (abs >= 1000000) return sign + sym + ' ' + (abs/1000000).toFixed(2) + ' MM';
    if (abs >= 1000) return sign + sym + ' ' + Math.round(abs/1000).toLocaleString('pt-BR') + 'k';
    return sign + sym + ' ' + Math.round(abs).toLocaleString('pt-BR');
}

function fmtN(val) {
    const abs = Math.abs(val);
    const sign = val < 0 ? '−' : '';
    if (abs >= 1000000) return sign + (abs/1000000).toFixed(2) + ' MM';
    if (abs >= 1000) return sign + Math.round(abs/1000).toLocaleString('pt-BR') + 'k';
    return sign + Math.round(abs).toLocaleString('pt-BR');
}

function recalc() {
    Object.keys(DATA).forEach(cia => {
        const d = DATA[cia];
        const sym = SYM[cia];
        const tbody = document.getElementById('tbody-' + cia);
        tbody.innerHTML = '';
        
        let totBruta = 0, totTat = 0, totLiq = 0, totVol = 0;
        
        for (let i = 0; i < 6; i++) {
            const vol_ml = d.vol[i];
            const pct = d.pct[i];
            const bruta = currentSign * vol_ml * 1000000 * currentDelta;
            const tat = bruta * pct;
            const liq = bruta - tat;
            
            totBruta += bruta;
            totTat += tat;
            totLiq += liq;
            totVol += vol_ml;
            
            const row = document.createElement('tr');
            row.innerHTML = `
                <td>${ANOS[i]}</td>
                <td>${vol_ml.toFixed(2)}</td>
                <td>${fmtN(bruta)}</td>
                <td>${fmtN(tat)}</td>
                <td class="net-col">${fmtN(liq)}</td>
            `;
            tbody.appendChild(row);
        }
        
        const totalRow = document.createElement('tr');
        totalRow.innerHTML = `
            <td>TOTAL 6Y</td>
            <td>${totVol.toFixed(2)}</td>
            <td>${fmtN(totBruta)}</td>
            <td>${fmtN(totTat)}</td>
            <td class="net-col">${fmtN(totLiq)}</td>
        `;
        tbody.appendChild(totalRow);
    });
}

document.getElementById('deltaInput').addEventListener('input', (e) => {
    currentDelta = parseFloat(e.target.value) || 0;
    document.getElementById('deltaSlider').value = currentDelta;
    recalc();
});

document.getElementById('deltaSlider').addEventListener('input', (e) => {
    currentDelta = parseFloat(e.target.value);
    document.getElementById('deltaInput').value = currentDelta.toFixed(2);
    recalc();
});

document.querySelectorAll('.sign-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
        document.querySelectorAll('.sign-btn').forEach(b => b.classList.remove('active'));
        e.target.classList.add('active');
        currentSign = e.target.dataset.sign === '+' ? 1 : -1;
        recalc();
    });
});

recalc();


// ============ PAINEL DE CONTROLE ============
const controlPanel = document.getElementById('controlPanel');
const controlToggle = document.getElementById('controlToggle');
const controlClose = document.getElementById('controlClose');

let panelOpen = true;

function setPanelState(open) {
    panelOpen = open;
    if (open) {
        controlPanel.classList.remove('collapsed');
        controlToggle.classList.remove('show');
    } else {
        controlPanel.classList.add('collapsed');
        controlToggle.classList.add('show');
    }
}

controlClose.addEventListener('click', () => setPanelState(false));
controlToggle.addEventListener('click', () => setPanelState(true));

// Estado inicial: começa aberto, mas após 4 segundos colapsa automaticamente
setTimeout(() => {
    if (panelOpen) setPanelState(false);
}, 4000);

// ---- Filtros de Companhia ----
const airlineFilters = document.querySelectorAll('#airlineFilters .filter-pill');
const airlineCards = document.querySelectorAll('.airline-card[data-airline]');
const sensCards = document.querySelectorAll('.sens-card[data-cia]');
const airlinesGrid = document.querySelector('.airlines-grid');
const sensitivityGrid = document.querySelector('.sensitivity-grid');

let activeAirlines = new Set(['GOL', 'Azul', 'TAP', 'Etihad']);

function applyAirlineFilter() {
    airlineCards.forEach(card => {
        const name = card.dataset.airline;
        if (activeAirlines.has(name)) {
            card.classList.remove('hidden');
        } else {
            card.classList.add('hidden');
        }
    });
    sensCards.forEach(card => {
        const name = card.dataset.cia;
        if (activeAirlines.has(name)) {
            card.classList.remove('hidden');
        } else {
            card.classList.add('hidden');
        }
    });
    
    // Se só 1 cia ativa, expande as colunas
    if (activeAirlines.size === 1) {
        if (airlinesGrid) airlinesGrid.classList.add('single-col');
        if (sensitivityGrid) sensitivityGrid.classList.add('single-col');
    } else {
        if (airlinesGrid) airlinesGrid.classList.remove('single-col');
        if (sensitivityGrid) sensitivityGrid.classList.remove('single-col');
    }
    
    // Atualiza estado do botão "Todas"
    const allBtn = document.querySelector('[data-airline="all"]');
    if (activeAirlines.size === 4) {
        allBtn.classList.add('active');
    } else {
        allBtn.classList.remove('active');
    }
}

airlineFilters.forEach(pill => {
    pill.addEventListener('click', () => {
        const target = pill.dataset.airline;
        
        if (target === 'all') {
            // Toggle: se todas ativas, desliga todas. Senão, liga todas.
            if (activeAirlines.size === 4) {
                activeAirlines.clear();
                document.querySelectorAll('#airlineFilters .filter-pill[data-airline]:not([data-airline="all"])').forEach(p => {
                    p.classList.remove('active');
                });
                pill.classList.remove('active');
            } else {
                activeAirlines = new Set(['GOL', 'Azul', 'TAP', 'Etihad']);
                document.querySelectorAll('#airlineFilters .filter-pill').forEach(p => {
                    p.classList.add('active');
                });
            }
        } else {
            if (activeAirlines.has(target)) {
                activeAirlines.delete(target);
                pill.classList.remove('active');
            } else {
                activeAirlines.add(target);
                pill.classList.add('active');
            }
        }
        
        applyAirlineFilter();
    });
});

// ---- Toggle de Seções ----
const sectionToggles = document.querySelectorAll('.section-toggle');

sectionToggles.forEach(toggle => {
    toggle.addEventListener('click', () => {
        const sectionName = toggle.dataset.section;
        const sw = toggle.querySelector('.switch');
        const isOn = sw.classList.contains('on');
        const targetSection = document.querySelector(`[data-section-name="${sectionName}"]`);
        
        if (isOn) {
            sw.classList.remove('on');
            if (targetSection) targetSection.classList.add('hidden');
        } else {
            sw.classList.add('on');
            if (targetSection) targetSection.classList.remove('hidden');
        }
    });
});

// ---- Modos Pre-definidos ----
const modeButtons = document.querySelectorAll('.mode-btn[data-mode]');

const MODES = {
    full: {
        sections: ['airlines', 'market', 'sensitivity', 'quotes'],
        printMode: false
    },
    compact: {
        sections: ['airlines', 'market', 'sensitivity'],
        printMode: false
    },
    financial: {
        sections: ['airlines', 'sensitivity'],
        printMode: false
    },
    print: {
        sections: ['airlines', 'market', 'sensitivity', 'quotes'],
        printMode: true
    }
};

function applyMode(modeName) {
    const mode = MODES[modeName];
    if (!mode) return;
    
    // Resetar toggles
    sectionToggles.forEach(toggle => {
        const sectionName = toggle.dataset.section;
        const sw = toggle.querySelector('.switch');
        const targetSection = document.querySelector(`[data-section-name="${sectionName}"]`);
        
        if (mode.sections.includes(sectionName)) {
            sw.classList.add('on');
            if (targetSection) targetSection.classList.remove('hidden');
        } else {
            sw.classList.remove('on');
            if (targetSection) targetSection.classList.add('hidden');
        }
    });
    
    // Print mode
    if (mode.printMode) {
        document.body.classList.add('print-mode');
    } else {
        document.body.classList.remove('print-mode');
    }
    
    // Atualizar botões
    modeButtons.forEach(b => b.classList.remove('active'));
    document.querySelector(`[data-mode="${modeName}"]`).classList.add('active');
}

modeButtons.forEach(btn => {
    btn.addEventListener('click', () => applyMode(btn.dataset.mode));
});

// ---- Print Button ----
document.getElementById('printBtn').addEventListener('click', () => {
    window.print();
});

// Atalho de teclado: P para print, F para toggle painel
document.addEventListener('keydown', (e) => {
    if (e.key === 'p' && (e.ctrlKey || e.metaKey)) return; // não interferir com Ctrl+P
    if (e.target.tagName === 'INPUT') return;
    
    if (e.key === 'f' || e.key === 'F') {
        setPanelState(!panelOpen);
    }
});




// ============ FILTRO POR ANO (DESTAQUE) ============
let currentYear = 'all';
const yearPills = document.querySelectorAll('#yearFilters .year-pill');

function applyYearHighlight() {
    document.querySelectorAll('.sens-table tbody tr').forEach(row => {
        const yearCell = row.cells[0];
        if (!yearCell) return;
        const yearText = yearCell.textContent.trim();
        
        if (currentYear === 'all') {
            row.style.opacity = '1';
            row.style.background = '';
        } else {
            if (yearText === currentYear) {
                row.style.opacity = '1';
                row.style.background = 'rgba(201, 169, 97, 0.12)';
            } else if (yearText === 'TOTAL 6Y') {
                row.style.opacity = '0.85';
                row.style.background = '';
            } else {
                row.style.opacity = '0.30';
                row.style.background = '';
            }
        }
    });
}

yearPills.forEach(pill => {
    pill.addEventListener('click', () => {
        yearPills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        currentYear = pill.dataset.year;
        applyYearHighlight();
    });
});

// Re-aplicar destaque depois que a tabela é recalculada
const originalRecalc = recalc;
recalc = function() {
    originalRecalc();
    applyYearHighlight();
};
recalc(); // re-run com nova função

// ============ SELETOR DE MOEDA ============
const FX = {
    'USD_BRL': 5.20,
    'USD_EUR': 0.93,
    'BRL_USD': 1 / 5.20,
    'BRL_EUR': 0.93 / 5.20,
    'EUR_USD': 1 / 0.93,
    'EUR_BRL': 5.20 / 0.93
};

// Original native data
const NATIVE_DATA = {
    'GOL':    { bruta: 180.14, tat: 34.68, liq: 146.67, sym: 'R$', code: 'BRL' },
    'Azul':   { bruta: 96.81,  tat: 18.73, liq: 78.98,  sym: 'R$', code: 'BRL' },
    'TAP':    { bruta: 17.89,  tat: 3.56,  liq: 14.25,  sym: '€',  code: 'EUR' },
    'Etihad': { bruta: 35.98,  tat: 8.71,  liq: 27.47,  sym: 'US$',code: 'USD' }
};

let currentCurrency = 'native';

function convert(value, fromCode, toCode) {
    if (fromCode === toCode) return value;
    const key = fromCode + '_' + toCode;
    if (FX[key]) return value * FX[key];
    // Conversão via USD
    if (fromCode !== 'USD' && toCode !== 'USD') {
        const inUSD = value * FX[fromCode + '_USD'];
        return inUSD * FX['USD_' + toCode];
    }
    return value;
}

function applyCurrency() {
    // Atualizar cards das cias na seção 01
    const symMap = { 'USD': 'US$', 'BRL': 'R$', 'EUR': '€' };
    
    Object.keys(NATIVE_DATA).forEach(cia => {
        const native = NATIVE_DATA[cia];
        const card = document.querySelector(`.airline-card[data-airline="${cia}"]`);
        if (!card) return;
        
        let bruta, tat, liq, displaySym;
        
        if (currentCurrency === 'native') {
            bruta = native.bruta;
            tat = native.tat;
            liq = native.liq;
            displaySym = native.sym;
        } else {
            bruta = convert(native.bruta, native.code, currentCurrency);
            tat = convert(native.tat, native.code, currentCurrency);
            liq = convert(native.liq, native.code, currentCurrency);
            displaySym = symMap[currentCurrency];
        }
        
        const heroNum = card.querySelector('.airline-hero-number');
        const heroCur = card.querySelector('.airline-hero-currency');
        const metricVals = card.querySelectorAll('.airline-metric .val');
        
        if (heroNum) heroNum.innerHTML = `${displaySym} ${bruta.toFixed(2)} MM`;
        if (heroCur) {
            const isConverted = currentCurrency !== 'native' && currentCurrency !== native.code;
            heroCur.innerHTML = isConverted 
                ? `Economia Bruta 6Y <span class="currency-converted-badge">CONVERTIDO</span>`
                : (cia === 'TAP' ? 'Economia Bruta 6Y · Inclui EU ETS' : 'Economia Bruta 6Y');
        }
        if (metricVals[0]) metricVals[0].innerHTML = `${displaySym} ${tat.toFixed(2)}<small> MM</small>`;
        if (metricVals[1]) metricVals[1].innerHTML = `${displaySym} ${liq.toFixed(2)}<small> MM</small>`;
    });
    
    // Atualizar consolidado no hero
    const breakdowns = document.querySelectorAll('.breakdown-row .val');
    if (breakdowns.length === 4 && currentCurrency !== 'native') {
        const ciasOrder = ['GOL', 'Azul', 'TAP', 'Etihad'];
        const symbol = symMap[currentCurrency];
        ciasOrder.forEach((cia, i) => {
            const native = NATIVE_DATA[cia];
            const val = convert(native.bruta, native.code, currentCurrency);
            breakdowns[i].textContent = `${symbol} ${val.toFixed(2)} MM`;
        });
        
        // Total consolidado
        let total = 0;
        ciasOrder.forEach(cia => {
            total += convert(NATIVE_DATA[cia].bruta, NATIVE_DATA[cia].code, currentCurrency);
        });
        const consolidated = document.querySelector('.consolidated-total');
        const consolidatedCur = document.querySelector('.consolidated-currency');
        if (consolidated) consolidated.textContent = `${symbol} ${total.toFixed(1)} MM`;
        if (consolidatedCur) consolidatedCur.textContent = `Total em ${currentCurrency} · Taxas Mai/2026`;
    } else if (currentCurrency === 'native') {
        // Restaurar valores nativos
        const breakdownVals = ['R$ 180,14 MM', 'R$ 96,81 MM', '€ 17,89 MM', 'US$ 35,98 MM'];
        document.querySelectorAll('.breakdown-row .val').forEach((el, i) => {
            if (breakdownVals[i]) el.textContent = breakdownVals[i];
        });
        const consolidated = document.querySelector('.consolidated-total');
        const consolidatedCur = document.querySelector('.consolidated-currency');
        if (consolidated) consolidated.textContent = '≈ US$ 103,5 MM';
        if (consolidatedCur) consolidatedCur.textContent = 'Equivalente em USD · Taxas Mai/2026';
    }
}

document.querySelectorAll('.currency-btn').forEach(btn => {
    btn.addEventListener('click', () => {
        document.querySelectorAll('.currency-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentCurrency = btn.dataset.currency;
        applyCurrency();
    });
});

// ============ MODO SLIDE (1 CIA POR TELA) ============
const SLIDE_DATA = [
    { 
        name: 'GOL', 
        tagline: 'Linhas Aéreas · Brasil · BRL',
        hero: 'R$ 180,14 MM',
        currency: 'Economia Bruta Acumulada · 2026–2031',
        tatFee: 'R$ 34,68 MM',
        tatPct: '19,2% da bruta',
        ciaLiq: 'R$ 146,67 MM',
        frota: '140',
        co2: '76 kt'
    },
    { 
        name: 'Azul', 
        tagline: 'Linhas Aéreas · Brasil · BRL',
        hero: 'R$ 96,81 MM',
        currency: 'Economia Bruta Acumulada · 2026–2031',
        tatFee: 'R$ 18,73 MM',
        tatPct: '19,3% da bruta',
        ciaLiq: 'R$ 78,98 MM',
        frota: '160',
        co2: '41 kt'
    },
    { 
        name: 'TAP', 
        tagline: 'Air Portugal · UE · EUR',
        hero: '€ 17,89 MM',
        currency: 'Economia Bruta 6Y · Inclui EU ETS shadow',
        tatFee: '€ 3,56 MM',
        tatPct: '19,9% da bruta',
        ciaLiq: '€ 14,25 MM',
        frota: '99',
        co2: '45 kt'
    },
    { 
        name: 'Etihad', 
        tagline: 'Airways · UAE · USD',
        hero: 'US$ 35,98 MM',
        currency: 'Economia Bruta Acumulada · 2026–2031',
        tatFee: 'US$ 8,71 MM',
        tatPct: '24,2% da bruta',
        ciaLiq: 'US$ 27,47 MM',
        frota: '128',
        co2: '131 kt'
    }
];

let currentSlide = 0;

function renderSlide(idx) {
    const data = SLIDE_DATA[idx];
    document.getElementById('slideAirlineName').textContent = data.name;
    document.getElementById('slideAirlineTagline').textContent = data.tagline;
    document.getElementById('slideHeroNumber').textContent = data.hero;
    document.getElementById('slideHeroCurrency').textContent = data.currency;
    document.getElementById('slideTatFee').textContent = data.tatFee;
    document.getElementById('slideTatPct').textContent = data.tatPct;
    document.getElementById('slideCiaLiq').textContent = data.ciaLiq;
    document.getElementById('slideFrota').textContent = data.frota;
    document.getElementById('slideCO2').textContent = data.co2;
    document.getElementById('slideCounter').textContent = String(idx + 1).padStart(2, '0') + ' / 04';
    
    // Logo brand - usa a logo do topo
    const topLogo = document.querySelector('.topbar-logo');
    const slideLogo = document.getElementById('slideBrandLogo');
    if (topLogo && slideLogo && topLogo.src) {
        slideLogo.src = topLogo.src;
    }
    
    // Dots
    document.querySelectorAll('.slide-dot').forEach((d, i) => {
        d.classList.toggle('active', i === idx);
    });
}

function enterSlideMode() {
    document.body.classList.add('slide-mode');
    currentSlide = 0;
    renderSlide(0);
    setPanelState(false);
}

function exitSlideMode() {
    document.body.classList.remove('slide-mode');
}

document.getElementById('slideModeBtn').addEventListener('click', enterSlideMode);
document.getElementById('slideExit').addEventListener('click', exitSlideMode);

document.getElementById('slideNext').addEventListener('click', () => {
    currentSlide = (currentSlide + 1) % SLIDE_DATA.length;
    renderSlide(currentSlide);
});

document.getElementById('slidePrev').addEventListener('click', () => {
    currentSlide = (currentSlide - 1 + SLIDE_DATA.length) % SLIDE_DATA.length;
    renderSlide(currentSlide);
});

document.querySelectorAll('.slide-dot').forEach(dot => {
    dot.addEventListener('click', () => {
        currentSlide = parseInt(dot.dataset.idx);
        renderSlide(currentSlide);
    });
});

// Navegação por teclado no modo slide
document.addEventListener('keydown', (e) => {
    if (!document.body.classList.contains('slide-mode')) return;
    
    if (e.key === 'ArrowRight' || e.key === ' ') {
        e.preventDefault();
        currentSlide = (currentSlide + 1) % SLIDE_DATA.length;
        renderSlide(currentSlide);
    } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        currentSlide = (currentSlide - 1 + SLIDE_DATA.length) % SLIDE_DATA.length;
        renderSlide(currentSlide);
    } else if (e.key === 'Escape') {
        exitSlideMode();
    } else if (e.key >= '1' && e.key <= '4') {
        currentSlide = parseInt(e.key) - 1;
        renderSlide(currentSlide);
    }
});


</script>


<!-- ============ MODO SLIDE (1 cia por tela) ============ -->
<div id="slide-stage">
    <button class="slide-exit" id="slideExit">✕  SAIR (ESC)</button>
    
    <div class="slide-content">
        <div class="slide-header">
            <div class="slide-brand">
                <img id="slideBrandLogo" src="" alt="TAT">
                <div class="slide-brand-text">
                    <div class="name">TAT Operating</div>
                    <div class="tagline">Aviation Performance</div>
                </div>
            </div>
            <div class="slide-counter" id="slideCounter">01 / 04</div>
        </div>
        
        <div class="slide-airline-name" id="slideAirlineName">GOL</div>
        <div class="slide-airline-tagline" id="slideAirlineTagline">Linhas Aéreas · BR · BRL</div>
        
        <div class="slide-hero-number" id="slideHeroNumber">R$ 180,14 MM</div>
        <div class="slide-hero-currency" id="slideHeroCurrency">Economia Bruta Acumulada · 2026–2031</div>
        
        <div class="slide-metrics">
            <div class="slide-metric">
                <div class="lbl">TAT Fee</div>
                <div class="val" id="slideTatFee">R$ 34,68 MM</div>
                <div class="sub" id="slideTatPct">19,2% da bruta</div>
            </div>
            <div class="slide-metric">
                <div class="lbl">Cia Líquido</div>
                <div class="val" id="slideCiaLiq">R$ 146,67 MM</div>
                <div class="sub" id="slideCiaSub">após TAT fee</div>
            </div>
            <div class="slide-metric">
                <div class="lbl">Frota</div>
                <div class="val" id="slideFrota">140</div>
                <div class="sub">aeronaves</div>
            </div>
            <div class="slide-metric">
                <div class="lbl">CO₂ Evitado</div>
                <div class="val" id="slideCO2">76 kt</div>
                <div class="sub">6 anos</div>
            </div>
        </div>
    </div>
    
    <div class="slide-nav">
        <button class="slide-nav-btn" id="slidePrev">◀</button>
        <div class="slide-nav-dots" id="slideDots">
            <div class="slide-dot active" data-idx="0"></div>
            <div class="slide-dot" data-idx="1"></div>
            <div class="slide-dot" data-idx="2"></div>
            <div class="slide-dot" data-idx="3"></div>
        </div>
        <button class="slide-nav-btn" id="slideNext">▶</button>
    </div>
</div>

</body>
</html>
