/* 2026 é parcial · Avianca = Nov-Dez (rollout Set-Out/26 · go-live Nov/26) */
const PARTIAL_2026 = { GOL: true, Azul: true, TAP: true, Etihad: true, AFKLM: true, United: true, Copa: true, American: true, Avianca: true };

/* Estado da seleção de anos (default: só 2027) */
let selectedSimYears = [2027];

