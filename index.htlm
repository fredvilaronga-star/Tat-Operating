            formula: 'Net share = Líquido / Bruta\n\n' +
                     'Bruta total 6Y:     ' + eff.symbol + ' ' + fmt(eff.bruta, 2) + ' MM\n' +
                     'Honorários TAT 6Y:  ' + eff.symbol + ' ' + fmt(eff.tat, 2) + ' MM (~' + fmt(eff.tat/eff.bruta*100, 0) + '%)\n' +
                     '  · Fee fixo:        ' + eff.symbol + ' ' + fmt(eff.fee_fixo, 2) + ' MM\n' +
                     '  · Recorrente 6Y:   ' + eff.symbol + ' ' + fmt(eff.bruta * 0.20, 2) + ' MM\n' +
                     '  · Success 2027:    ' + eff.symbol + ' ' + fmt(eff.bruta * 0.23 * 0.20, 2) + ' MM\n' +
                     'Líquido operador:   ' + eff.symbol + ' ' + fmt(eff.liq, 2) + ' MM (~' + fmt((eff.liq/eff.bruta)*100, 0) + '%)\n\n' +
                     'Distribuição por ano:\n' +
                     '  2026 (Setup):  bruta 6% · líquido absoluto (após fee fixo)\n' +
                     '  2027 (Pico):   bruta 25% · operador captura 60% líquido\n' +
                     '  2028-31 (Esteira): bruta 69% · operador captura 80% líquido',
            method: 'O operador captura ~75% líquido sobre a bruta total. Em 2027 (ano pico) TAT cobra 40% mas é também o ano de maior captura absoluta. Fee fixo de diagnóstico e implantação representa <0,5% da bruta total — é pago em 4 meses (jun-set/26) antes do recorrente começar.',
            sources: ['Estrutura comercial TAT', 'Modelo de honorário híbrido']
        },
        'phase-1': {
            title: 'Fase 01 · Setup (Jun-Set/2026)',
            value: eff.symbol + ' ' + fmt((eff.bruta / eff.hMult) * 0.06 - eff.fee_fixo - (eff.bruta / eff.hMult) * 0.06 * 0.20, 2) + ' MM líquido',
            formula: 'Período: Jun-Set 2026 (4 meses) · 6% da bruta total\n\n' +
                     'Cronograma (GOL/Azul):\n' +
                     '  Diagnóstico: Jun-Jul/2026 · ' + eff.symbol + ' ' + fmt(eff.fee_fixo * 0.333, 2) + ' MM (fixo)\n' +
                     '  Implantação: Ago-Set/2026 · ' + eff.symbol + ' ' + fmt(eff.fee_fixo * 0.667, 2) + ' MM (fixo)\n' +
                     '  Recorrente:  a partir de Out/2026\n\n' +
                     'Cronograma (TAP/Etihad):\n' +
                     '  Diagnóstico: Jul-Ago/2026\n' +
                     '  Implantação: Set-Out/2026\n' +
                     '  Recorrente:  a partir de Nov/2026\n\n' +
                     'Cálculo do líquido 2026:\n' +
                     '  Bruta 2026 (6%):      ' + eff.symbol + ' ' + fmt((eff.bruta / eff.hMult) * 0.06, 2) + ' MM\n' +
                     '  − Fee fixo total:     ' + eff.symbol + ' ' + fmt(eff.fee_fixo, 2) + ' MM\n' +
                     '  − Recorrente 20%:     ' + eff.symbol + ' ' + fmt((eff.bruta / eff.hMult) * 0.06 * 0.20, 2) + ' MM\n' +
                     '  = LÍQUIDO 2026:       ' + eff.symbol + ' ' + fmt((eff.bruta / eff.hMult) * 0.06 - eff.fee_fixo - (eff.bruta / eff.hMult) * 0.06 * 0.20, 2) + ' MM\n\n' +
                     'Payback do fee fixo: ~' + fmt(eff.fee_fixo / ((eff.bruta / eff.hMult) * 0.06 / 12), 1) + ' meses de captura',
            method: 'O fee fixo (diagnóstico + implantação) é pago em 4 meses específicos antes do recorrente começar. Com 6% da bruta total capturada já em 2026, o fee fixo se paga em apenas ' + fmt(eff.fee_fixo / ((eff.bruta / eff.hMult) * 0.06 / 12), 1) + ' meses. A partir de Out/Nov 2026, o operador captura 80% líquido (recorrente 20%).',
            sources: ['Cronograma detalhado · Fase 01', 'Termo de honorário fixo · diagnóstico e implantação']
        },
        'phase-2': {
            title: 'Fase 02 · Pico (Jan-Dez/2027)',
            value: '60% líquido para o operador',
            formula: 'Período: Jan-Dez 2027 (ano completo) · 25% da bruta total\n\n' +
                     'Honorário no ano: 20% recorrente + 20% success = 40% total\n\n' +
                     'Captura bruta:    ' + eff.symbol + ' ' + fmt((eff.bruta / eff.hMult) * 0.25, 2) + ' MM\n' +
                     'Honorários TAT:   ' + eff.symbol + ' ' + fmt((eff.bruta / eff.hMult) * 0.25 * 0.40, 2) + ' MM (40%)\n' +
                     '  · Recorrente 20%: ' + eff.symbol + ' ' + fmt((eff.bruta / eff.hMult) * 0.25 * 0.20, 2) + ' MM\n' +
                     '  · Success 20%:    ' + eff.symbol + ' ' + fmt((eff.bruta / eff.hMult) * 0.25 * 0.20, 2) + ' MM\n' +
                     'LÍQUIDO OPERADOR: ' + eff.symbol + ' ' + fmt((eff.bruta / eff.hMult) * 0.25 * 0.60, 2) + ' MM (60%)',
            method: 'Ano de pico operacional E ano de pico de honorário. Modelo alinha incentivos: TAT ganha mais quando o operador captura mais. 40% pode parecer alto — mas o operador captura 60% líquido sobre a maior captura anual do programa inteiro. O valor absoluto líquido em 2027 é o segundo maior do programa (atrás apenas da soma 2028-2031).',
            sources: ['Roadmap detalhado · Fase 02', 'Termo de success fee 2027']
        },
        'phase-3': {
            title: 'Fase 03 · Esteira (2028-2031)',
            value: '80% líquido para o operador',
            formula: 'Período: Jan/2028 – Dez/2031 (4 anos) · 69% da bruta total\n\n' +
                     'Honorário: 20% recorrente · sem success fee adicional\n\n' +
                     'Captura bruta 4 anos: ' + eff.symbol + ' ' + fmt((eff.bruta / eff.hMult) * 0.69, 2) + ' MM\n' +
                     'Honorários TAT:       ' + eff.symbol + ' ' + fmt((eff.bruta / eff.hMult) * 0.69 * 0.20, 2) + ' MM (20%)\n' +
                     'LÍQUIDO OPERADOR:     ' + eff.symbol + ' ' + fmt((eff.bruta / eff.hMult) * 0.69 * 0.80, 2) + ' MM (80%)\n\n' +
                     'Anualizado:\n' +
                     '  Captura/ano:  ' + eff.symbol + ' ' + fmt((eff.bruta / eff.hMult) * 0.69 / 4, 2) + ' MM\n' +
                     '  Líquido/ano:  ' + eff.symbol + ' ' + fmt((eff.bruta / eff.hMult) * 0.69 / 4 * 0.80, 2) + ' MM',
            method: 'Esteira: o programa em velocidade de cruzeiro. TAT continua entregando (otimização contínua via ML embarcado, auditoria trimestral) mas sem prêmio de pico. Operador captura 80% líquido sobre a maior fatia de bruta do programa (69% do total em 4 anos).',
            sources: ['Roadmap detalhado · Fase 03', 'Operação em esteira · auditoria trimestral']
        },
    };

    return AUDITS[key] || null;
}

function openAudit(key){
    const a = buildAuditContent(key);
    if (!a) return;

    const body = document.getElementById('auditBody');
    document.getElementById('auditTitle').textContent = a.title;

    let html = '<div class="audit-value">' + a.value + '</div>';

    if (a.sens === 'qav'){
        const eff = computeEffective();
        html += '<div class="audit-sens-control">';
        html += '  <span class="audit-sens-label">ΔQAV</span>';
        html += '  <input type="range" min="-1" max="1" step="0.05" value="0" class="audit-sens-slider" id="auditSlider">';
        html += '  <span class="audit-sens-val" id="auditSliderVal">+0,00</span>';
        html += '</div>';
        html += '<div class="audit-sens-result" id="auditSensResult">' + eff.symbol + ' ' + fmt(eff.bruta, 2) + ' MM</div>';
        html += '<div class="audit-sens-delta" id="auditSensDelta">+0,00 MM</div>';
        html += '<div style="height: 28px;"></div>';
    }

    html += '<div class="audit-section">';
    html += '  <div class="audit-section-label">Fórmula</div>';
    html += '  <pre class="audit-formula"></pre>';
    html += '</div>';
    html += '<div class="audit-section">';
    html += '  <div class="audit-section-label">Método e premissas</div>';
    html += '  <p class="audit-prose"></p>';
    html += '</div>';
    html += '<div class="audit-section">';
    html += '  <div class="audit-section-label">Fontes</div>';
    html += '  <div class="audit-sources"></div>';
    html += '</div>';

    body.innerHTML = html;

    /* Preencher texto via .textContent para evitar HTML injection */
    body.querySelector('.audit-formula').textContent = a.formula;
    body.querySelector('.audit-prose').textContent = a.method;
    const sourcesEl = body.querySelector('.audit-sources');
    a.sources.forEach(s => {
        const div = document.createElement('div');
        const span = document.createElement('span');
        span.textContent = '▪';
        div.appendChild(span);
        div.appendChild(document.createTextNode(s));
        sourcesEl.appendChild(div);
    });

    /* Bind slider */
    if (a.sens === 'qav'){
        const slider = document.getElementById('auditSlider');
        const val = document.getElementById('auditSliderVal');
        const res = document.getElementById('auditSensResult');
        const delta = document.getElementById('auditSensDelta');
        slider.addEventListener('input', () => {
            const eff = computeEffective();
            const d = parseFloat(slider.value) || 0;
            val.textContent = (d>=0?'+':'') + fmt(d, 2);
            const totalDelta = (d / 0.05) * eff.delta_per_005;
            const newBruta = eff.bruta + totalDelta;
            res.textContent = eff.symbol + ' ' + fmt(newBruta, 2) + ' MM';
            delta.textContent = (totalDelta >= 0 ? '+' : '') + eff.symbol + ' ' + fmt(totalDelta, 2) + ' MM';
            delta.className = 'audit-sens-delta' + (totalDelta < 0 ? ' neg' : '');
        });
    }

    document.getElementById('auditPanel').classList.add('open');
    document.getElementById('auditBackdrop').classList.add('visible');
}

function closeAudit(){
    document.getElementById('auditPanel').classList.remove('open');
    document.getElementById('auditBackdrop').classList.remove('visible');
}

/* =====================================================================
   NAVIGATION
   ===================================================================== */
function goToSlide(n){
    n = Math.max(1, Math.min(5, n));
    STATE.slide = n;
    renderAll();
    window.scrollTo({top: 0, behavior: 'smooth'});
}

/* =====================================================================
   RAIL MENU OPEN/CLOSE
   ===================================================================== */
function toggleRailMenu(filterEl){
    document.querySelectorAll('.rail-filter').forEach(f => {
        if (f !== filterEl) f.classList.remove('open');
    });
    filterEl.classList.toggle('open');
    document.querySelectorAll('.rail-menu').forEach(m => {
        m.classList.toggle('open', m.parentElement.classList.contains('open'));
    });
}
function closeAllRailMenus(){
    document.querySelectorAll('.rail-filter').forEach(f => f.classList.remove('open'));
    document.querySelectorAll('.rail-menu').forEach(m => m.classList.remove('open'));
}

/* =====================================================================
   MORE PANEL (painel "+ filtros")
   ===================================================================== */
function toggleMorePanel(){
    const panel = document.getElementById('morePanel');
    const btn = document.getElementById('moreToggle');
    const open = panel.classList.toggle('open');
    btn.classList.toggle('active', open);
    document.body.classList.toggle('more-open', open);
    /* Atualizar só o text node inicial do botão; o span#moreCount permanece intacto */
    btn.firstChild.textContent = open ? '− Filtros' : '+ Filtros';
    updateFilterCounters();
}

