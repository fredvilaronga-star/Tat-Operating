function applyI18n() {
    const isEN = (isEn(STATE.cia));
    document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.dataset.i18n;
        const ptOrig = el.dataset.i18nPt || el.textContent;
        if (!el.dataset.i18nPt) el.dataset.i18nPt = el.textContent;
        if (isEN && I18N_EN[key]) {
            el.textContent = I18N_EN[key];
        } else {
            el.textContent = el.dataset.i18nPt;
        }
    });
    document.querySelectorAll('[data-i18n-html]').forEach(el => {
        const key = el.dataset.i18nHtml;
        const ptOrig = el.dataset.i18nPtHtml || el.innerHTML;
        if (!el.dataset.i18nPtHtml) el.dataset.i18nPtHtml = el.innerHTML;
        if (isEN && I18N_EN[key]) {
            el.innerHTML = I18N_EN[key];
        } else {
            el.innerHTML = el.dataset.i18nPtHtml;
        }
    });
}

let STATE = {
    cia: null,
    horizon: '6Y',
    scenario: 'base',
    currency: 'native',
    focus: 'all',
    view: 'full',
    aircraft: 'all',
    hub: 'all',
    slide: 1,
};

/* Defaults para comparar e contar filtros ativos */
const DEFAULTS = {
    horizon: '6Y', scenario: 'base', currency: 'native',
    focus: 'all', view: 'full', aircraft: 'all', hub: 'all'
};

/* =====================================================================
   localStorage
   ===================================================================== */
try {
    const raw = localStorage.getItem('tat_memo_v7');
    if (raw){
        const d = JSON.parse(raw);
        if (d && d.expires > Date.now()){
            if (Array.isArray(d.cias)) {
                selectedCias = d.cias.filter(c => DATA[c]);
                if (selectedCias.length > 0) STATE.cia = selectedCias[0];
            } else if (DATA[d.cia]) {
                STATE.cia = d.cia;
                selectedCias = [d.cia];
            }
            if (d.horizon)   STATE.horizon = d.horizon;
            if (d.scenario)  STATE.scenario = d.scenario;
            if (d.currency)  STATE.currency = d.currency;
            if (d.focus)     STATE.focus = d.focus;
            if (d.view)      STATE.view = d.view;
            if (d.aircraft)  STATE.aircraft = d.aircraft;
            if (d.hub)       STATE.hub = d.hub;
            if (d.slide)     STATE.slide = Math.max(1, Math.min(5, d.slide));
        }
    }
} catch(e){}

function persistState(){
    try {
        localStorage.setItem('tat_memo_v7', JSON.stringify({
            cias: selectedCias,
            cia: STATE.cia, horizon: STATE.horizon, scenario: STATE.scenario,
            currency: STATE.currency, focus: STATE.focus, view: STATE.view,
            aircraft: STATE.aircraft, hub: STATE.hub, slide: STATE.slide,
            expires: Date.now() + 24*3600*1000
        }));
    } catch(e){}
}

/* =====================================================================
   FORMATTERS
   ===================================================================== */
function fmt(n, dec){
    dec = dec === undefined ? 2 : dec;
    if (!isFinite(n)) return '—';
    return n.toLocaleString('pt-BR', {minimumFractionDigits: dec, maximumFractionDigits: dec});
}
function fmtInt(n){
    if (!isFinite(n)) return '—';
    return Math.round(n).toLocaleString('pt-BR');
}
function fxConvert(value, from, to){
    if (from === to) return value;
    return value * FX_TO_USD[from] * FX_FROM_USD[to];
}

/* =====================================================================
   COMPUTE EFFECTIVE — motor único
   ===================================================================== */

/* ===== MULTI-CIA ===== */
let selectedCias = [];  /* array de cias ativas */

function consolidateData(cias){
    /* Soma valores em USD; retorna objeto consolidado com mesma shape de DATA[cia] */
    if (cias.length === 0) return null;
    if (cias.length === 1) return DATA[cias[0]];
    
    let bruta=0, tat=0, liq=0, co2=0, vol=0, fleet=0;
    let bruta_ann=0, fee_fixo=0, delta_per_005=0;
    let total_rev_usd_bb = 0;
    let weighted_ebit = 0, total_w = 0;
    
    cias.forEach(c => {
        const d = DATA[c];
        if (!d) return;
        const fx = FX_TO_USD[d.currency];  /* converte fontes para USD */
        bruta += d.bruta_6y * fx;
        tat += d.tat_6y * fx;
        liq += d.liq_6y * fx;
        co2 += d.co2;
        vol += d.volume_6y;
        fleet += d.fleet;
        bruta_ann += d.bruta_ann * fx;
        fee_fixo += d.fee_fixo * fx;
        delta_per_005 += d.delta_per_005 * fx;
        total_rev_usd_bb += d.revenue_usd_bb;
        const w = d.revenue_usd_bb;
        weighted_ebit += d.ebit_margin_base * w;
        total_w += w;
    });
    
    return {
        currency: 'USD',
        symbol: 'US$',
        fleet: fleet,
        bruta_6y: bruta,
        tat_6y: tat,
        liq_6y: liq,
        bruta_ann: bruta_ann,
        fee_fixo: fee_fixo,
        fee_fixo_breakdown: cias.length + ' contratos · honorários por cia',
        payback_months: 1.5,  /* placeholder consolidado · não usado normalmente */
        liq_2027_pct: 60,
        liq_steady_pct: 80,
        qav_baseline: 5.91,  /* placeholder — consolidado não tem QAV único */
        delta_per_005: delta_per_005,
        co2: co2,
        volume_6y: vol,
        qav_hub_default: '— múltiplos hubs —',
        qav_value_default: 'múltiplos · ver por cia',
        qav_delta_default: 'múltiplos',
        qav_source_default: 'Consolidado em USD · PTAX Mai/26',
        hubs: [],  /* sem hub no modo consolidado */
        ebit_margin_base: total_w > 0 ? weighted_ebit / total_w : 0.04,
        revenue_usd_bb: total_rev_usd_bb,
        language: 'pt',
        voice_text: 'A pressão sobre QAV nas múltiplas geografias força repensar toda eficiência operacional capturável sem CAPEX.',
        voice_name: 'Consolidado · ' + cias.length + ' operadores',
        voice_role: cias.join(' · '),
        is_consolidated: true,
        cias_list: cias,
    };
}

function computeEffective(){
    if (selectedCias.length === 0) return null;
    const base = consolidateData(selectedCias);
    if (!base) return null;
    const sourceCcy = base.currency;
    const targetCcy = STATE.currency === 'native' ? sourceCcy : STATE.currency;
    const fxFactor = fxConvert(1, sourceCcy, targetCcy);

    /* Cenário QAV */
    const qavDelta = SCENARIO_DELTA[STATE.scenario] || 0;
    let bruta = base.bruta_6y, tat = base.tat_6y, liq = base.liq_6y;
    if (qavDelta !== 0){
        const brutaShift = (qavDelta / 0.05) * base.delta_per_005;
        const newBruta = bruta + brutaShift;
        const tatPct = tat / bruta;
        bruta = newBruta;
        tat = newBruta * tatPct;
        liq = newBruta - tat;
    }

    /* Multiplicadores combinados */
    const hMult = HORIZON_MULT[STATE.horizon] || 1.0;
    const acMult = AIRCRAFT_MULT[STATE.aircraft] || 1.0;
    const combinedMult = hMult * acMult;

    return {
        baseCia: base,
        sourceCcy: sourceCcy,
        targetCcy: targetCcy,
        symbol: CCY_SYMBOL[targetCcy],
        bruta: bruta * combinedMult * fxFactor,
        tat: tat * combinedMult * fxFactor,
        liq: liq * combinedMult * fxFactor,
        co2: base.co2 * combinedMult,
        volume: base.volume_6y * combinedMult,
        bruta_ann: (bruta / 6) * combinedMult * fxFactor,
        fee_fixo: base.fee_fixo * fxFactor,
        fee_fixo_breakdown: base.fee_fixo_breakdown,
        payback_months: base.payback_months,
        liq_2027_pct: base.liq_2027_pct,
        liq_steady_pct: base.liq_steady_pct,
        delta_per_005: base.delta_per_005 * combinedMult * fxFactor,
        qav_baseline: base.qav_baseline + qavDelta,
        qav_baseline_target: fxConvert(base.qav_baseline + qavDelta, sourceCcy, targetCcy),
        qav_hub_default: base.qav_hub_default,
        qav_value_default: base.qav_value_default,
        qav_delta_default: base.qav_delta_default,
        qav_source_default: base.qav_source_default,
        ebit_margin: base.ebit_margin_base,
        revenue_usd_bb: base.revenue_usd_bb,
        revenue_local: base.revenue_usd_bb * 1000 * FX_FROM_USD[targetCcy],
        fleet: Math.round(base.fleet * acMult),
        fleet_orig: base.fleet,
        language: base.language,
        voice_text: base.voice_text,
        voice_name: base.voice_name,
        voice_role: base.voice_role,
        hubs: base.hubs,
        horizonLabel: HORIZON_LABEL[STATE.horizon],
        aircraftLabel: AIRCRAFT_LABEL[STATE.aircraft],
        scenario: STATE.scenario,
        hMult: hMult,
        acMult: acMult,
        combinedMult: combinedMult,
    };
}

/* =====================================================================
   RENDER
   ===================================================================== */
function renderAll(){
    if (selectedCias.length === 0){
        document.body.classList.add('no-cia');
        return;
    }
    document.body.classList.remove('no-cia');

    /* I18N — Etihad em inglês, demais em português */
    applyI18n();

    const eff = computeEffective();
    const $ = (id) => document.getElementById(id);

    /* RAIL labels */
    if (selectedCias.length === 0) {
        $('filterCiaValue').textContent = 'Selecione';
    } else if (selectedCias.length === 1) {
        $('filterCiaValue').textContent = selectedCias[0];
    } else if (selectedCias.length === 4) {
        $('filterCiaValue').textContent = 'Consolidado · 4';
    } else {
        $('filterCiaValue').textContent = selectedCias.join(' + ');
    }
    $('filterHorizonValue').textContent = (isEn(STATE.cia) ? HORIZON_LABEL_EN : HORIZON_LABEL)[STATE.horizon];
    $('filterScenarioValue').textContent = isEn(STATE.cia)
        ? ({base:'Base', bear:'Bear', bull:'Bull'}[STATE.scenario] || 'Base')
        : (STATE.scenario.charAt(0).toUpperCase() + STATE.scenario.slice(1));
    $('filterCurrencyValue').textContent = STATE.currency === 'native'
        ? (isEn(STATE.cia) ? 'Native' : 'Nativa')
        : STATE.currency;

    /* Marcadores visuais de filtros não-default */
    document.getElementById('filterHorizon').classList.toggle('active-filter', STATE.horizon !== '6Y');
    document.getElementById('filterScenario').classList.toggle('active-filter', STATE.scenario !== 'base');
    document.getElementById('filterCurrency').classList.toggle('active-filter', STATE.currency !== 'native');

    /* Active menu items */
    document.querySelectorAll('.rail-menu-item').forEach(it => it.classList.remove('active'));
    selectedCias.forEach(c => {
        document.querySelectorAll('[data-cia-multi="' + c + '"]').forEach(it => it.classList.add('active'));
    });
    document.querySelectorAll('[data-horizon="' + STATE.horizon + '"]').forEach(it => it.classList.add('active'));
    document.querySelectorAll('[data-scenario="' + STATE.scenario + '"]').forEach(it => it.classList.add('active'));
    document.querySelectorAll('[data-currency="' + STATE.currency + '"]').forEach(it => it.classList.add('active'));

    /* SLIDE 1 */
    const _isEnMeta = (isEn(STATE.cia));
    let metaParts = [];
    if (selectedCias.length === 1) {
        metaParts.push(STATE.cia);
    } else if (selectedCias.length === 4) {
        metaParts.push(_isEnMeta ? '4 operators · USD' : '4 operadores · USD');
    } else if (selectedCias.length > 1) {
        metaParts.push(selectedCias.join(' + ') + ' · USD');
    }
    metaParts.push(_isEnMeta ? HORIZON_LABEL_EN[STATE.horizon] : eff.horizonLabel);
    if (STATE.scenario !== 'base') metaParts.push((_isEnMeta ? 'Scenario ' : 'Cenário ') + STATE.scenario.charAt(0).toUpperCase() + STATE.scenario.slice(1));
    if (STATE.aircraft !== 'all') metaParts.push(eff.aircraftLabel);
    if (STATE.currency !== 'native') metaParts.push(STATE.currency);
    $('metaSituation').textContent = metaParts.join(' · ');

    $('anchorVolume').textContent = fmt(eff.volume, 1);

    /* QAV hub - escolhe entre hub selecionado e default */
    let hubDisplay = eff.qav_value_default;
    let hubDeltaDisplay = eff.qav_delta_default;
    if (STATE.hub !== 'all' && HUB_QAV[STATE.hub]){
        hubDisplay = HUB_QAV[STATE.hub];
    }
    /* Mostra só o preço médio (primeiro número) — não duplicar /L se já houver */
    let hubPrice = hubDisplay.replace(' – ', '–').split('–')[0].trim();
    if (!hubPrice.endsWith('/L')) hubPrice += '/L';
    $('sideHubQav').textContent = hubPrice;
    $('sideHubDelta').textContent = hubDeltaDisplay;
    $('sideFrota').textContent = eff.fleet + ' ac' + (STATE.aircraft !== 'all' ? ' · ' + eff.aircraftLabel : '');
    $('sideCo2').textContent = fmtInt(eff.co2) + ' kt';

    /* Slide 1 — textos por idioma da cia */
    const isEN = (isEn(STATE.cia));

    if (isEN) {
        /* Etihad/AFKLM: layout completo em inglês + voice block (dinâmico do DATA) */
        $('s1Num').textContent = '01 · Situation';
        $('s1Title').innerHTML = "There's an avoidable fuel cost<br>in your network.<em> Today.</em>";
        $('ledeSituation').textContent = '';
        $('s1AnchorLabel').textContent = 'Volume of avoidable jet fuel · 6 years';
        $('s1AnchorCaption').textContent = 'Litres not burned · click for audit';
        $('s1SideLbl1').textContent = 'Jet fuel at hub';
        $('s1SideLbl2').textContent = 'Increase vs base';
        $('s1SideLbl3').textContent = 'Fleet analysed';
        $('s1SideLbl4').textContent = 'CO₂ avoided';
        $('s1EvTag1').textContent = 'Operating Cost';
        $('s1EvSub1').textContent = 'Jet fuel as a share of total operating cost (IATA, 2026). Any reduction has dual impact: cash and margin.';
        $('s1EvTag2').textContent = 'Structural Demand';
        $('s1EvSub2').textContent = (STATE.cia === 'AFKLM')
            ? 'EU ETS free allowances reached 0% in 2026. Every tonne of CO₂ not emitted is a direct avoided EUA purchase at € 71/t. Plus ReFuelEU SAF mandate ramping 2% → 6% by 2030.'
            : (STATE.cia === 'United')
            ? 'United paid US$ 2.78/USG in Q1 2026 (+US$ 340M YoY). Q2 guidance US$ 4.30/USG post-Iran War. Non-hedged structure. Lauren Riley (CSO) net-zero 2050 mandate without traditional offsets.'
            : (STATE.cia === 'Copa')
            ? 'Copa operates 100% Boeing 737 fleet with industry-leading low unit costs. Single PTY hub concentrates operations. MAX 9 transition driving 15-20% fuel efficiency gains. CORSIA Phase 1 & 2 signatory.'
            : (STATE.cia === 'American')
            ? 'American paid Q1 2026 fuel +US$ 341M YoY. Sole Big 3 without refinery nor hedge — full spot exposure. SBTi-validated (first global airline). 45% intensity reduction target by 2035 vs 2019 baseline.'
            : (STATE.cia === 'Avianca')
            ? 'Avianca operates BOG (altitude 2,640m · 0.94 thermal factor) + SAL secondary hub. Largest dedicated cargo operator in TAT portfolio (9 A330F · 220 flights/week). Abra Group synergy with GOL — methodology pre-validated.'
            : 'Jet fuel demand Aug/26 vs Mar/26 (IEA Birol). Northern hemisphere summer peak. Persistent pressure.';

        /* Voice block — dinâmico do DATA */
        const ciaData = DATA[STATE.cia];
        if (ciaData && ciaData.voice_text) {
            $('s1VoiceBlock').style.display = 'block';
            $('s1VoiceText').textContent = '"' + ciaData.voice_text + '"';
            $('s1VoiceName').textContent = ciaData.voice_name;
            $('s1VoiceRole').textContent = ciaData.voice_role;
        }
    } else {
        /* Modo completo PT (GOL/Azul/TAP) */
        $('s1Num').textContent = '01 · Situação';
        $('s1Title').innerHTML = 'Há um custo evitável<br>de combustível na sua malha.<em> Hoje.</em>';
        $('s1AnchorLabel').textContent = 'Volume de QAV economizável · 6 anos';
        $('s1AnchorCaption').textContent = 'Litros não consumidos · clique para auditoria';
        $('s1SideLbl1').textContent = 'QAV no hub';
        $('s1SideLbl2').textContent = 'Alta vs base';
        $('s1SideLbl3').textContent = 'Frota analisada';
        $('s1SideLbl4').textContent = 'CO₂ evitável';
        $('s1EvTag1').textContent = 'Custo Operacional';
        $('s1EvSub1').textContent = 'QAV no custo operacional total (ABEAR, 2026). Qualquer redução tem impacto duplo: caixa e margem.';
        $('s1EvTag2').textContent = 'Demanda Estrutural';
        $('s1EvSub2').textContent = 'Demanda jet fuel em ago/26 vs mar/26 (IEA Birol). Pico operacional do verão setentrional. Pressão persistente.';

        /* Voice block hidden for PT cias */
        $('s1VoiceBlock').style.display = 'none';

        /* Lede situation PT */
        const ledeMap = {
            GOL: 'QAV no maior hub doméstico saltou +100% vs Fev/2026. Aviação opera com margens estreitas. Cada litro economizado vai direto para caixa.',
            Azul: 'QAV no maior hub doméstico saltou +100% vs Fev/2026. Frota regional opera com mais variabilidade de LF. Eficiência ground-side neutraliza parte da volatilidade.',
            TAP: 'QAV em LIS subiu +101% vs 2025 (IATA). EU ETS aumenta o custo carbono. A captura ground-side compõe redução de combustível com redução de exposição regulatória.'
        };
        $('ledeSituation').textContent = ledeMap[STATE.cia] || ledeMap.GOL;
    }

    /* SLIDE 3 */
    $('resCcy').textContent = eff.symbol;
    $('resLiq').textContent = fmt(eff.liq, 2);
    /* Hero eyebrow mostra consolidação se aplicável */
    const heroEyebrowEl = document.querySelector('.slide-hero .hero-eyebrow');
    if (heroEyebrowEl) {
        const isEnHero = (isEn(STATE.cia));
        if (selectedCias.length === 1) {
            heroEyebrowEl.innerHTML = isEnHero
                ? 'Net savings · 6 years · post TAT fees'
                : 'Economia líquida · 6 anos · pós honorários TAT';
        } else if (selectedCias.length === 4) {
            heroEyebrowEl.innerHTML = isEnHero
                ? 'Consolidated net savings · 6 years · 4 operators <span class="consolidated-badge">USD</span>'
                : 'Economia líquida consolidada · 6 anos · 4 operadores <span class="consolidated-badge">USD</span>';
        } else {
            heroEyebrowEl.innerHTML = (isEnHero
                ? 'Consolidated net savings · 6 years · '
                : 'Economia líquida consolidada · 6 anos · ') + selectedCias.join(' + ') + ' <span class="consolidated-badge">USD</span>';
        }
    }

    $('brutaCcy').textContent = eff.symbol;
    $('brutaVal').textContent = fmt(eff.bruta, 2);
    $('tatCcy').textContent = eff.symbol;
    $('tatVal').textContent = fmt(eff.tat, 2);
    $('ratioVal').textContent = fmt(eff.liq / eff.tat, 1) + '×';
    const ratioEl2 = document.getElementById('ratioVal2');
    if (ratioEl2) ratioEl2.textContent = fmt(eff.liq / eff.tat, 1) + '×';

    /* Net share: % da bruta que fica com o operador (1 - tat/bruta) */
    const netSharePct = (eff.liq / eff.bruta) * 100;
    const netEl = document.getElementById('netShareVal');
    if (netEl) netEl.textContent = '~' + fmt(netSharePct, 0) + '%';
    const netEl2 = document.getElementById('netShareVal2');
    if (netEl2) netEl2.innerHTML = '~' + fmt(netSharePct, 0) + '<span style="font-size:18px;color:var(--mute);font-weight:400;">%</span>';

    /* Tagline dinâmica do slide 2 — usa os percentuais REAIS do estudo da cia ativa */
    const taglineEl = document.querySelector('[data-i18n-html="s2.tagline"]');
    if (taglineEl) {
        const pct27 = eff.liq_2027_pct || 60;
        const pctSteady = eff.liq_steady_pct || 80;
        const baseCia = eff.baseCia || {};
        const windowLbl = baseCia.tagline_window_label;
        const steadyLbl = baseCia.tagline_steady_label;
        const paybackDisplay = (eff.payback_months && eff.payback_months < 1.0)
            ? ('~' + Math.round(eff.payback_months * 30) + ' days')
            : ('~' + fmt(eff.payback_months || 1.5, 1) + ' months');
        if (isEn(STATE.cia)) {
            if (windowLbl && steadyLbl) {
                taglineEl.innerHTML = 'Fixed fee pays back in <em>' + paybackDisplay + '</em>.<br>\n                    Operator captures <em>' + pct27 + '%</em> ' + windowLbl + ' · <em>' + pctSteady + '%</em> ' + steadyLbl + '.';
            } else {
                taglineEl.innerHTML = 'Fixed fee pays back in <em>' + paybackDisplay + '</em>.<br>\n                    In 2027 operator captures <em>' + pct27 + '%</em> · from 2028 to 2031 captures <em>' + pctSteady + '%</em>.';
            }
        } else {
            const paybackDisplayPt = (eff.payback_months && eff.payback_months < 1.0)
                ? ('~' + Math.round(eff.payback_months * 30) + ' dias')
                : ('~' + fmt(eff.payback_months || 1.5, 1) + ' meses');
            taglineEl.innerHTML = 'Fee fixo se paga em <em>' + paybackDisplayPt + '</em>.<br>\n                    Em 2027 operador captura <em>' + pct27 + '%</em> · de 2028 a 2031 captura <em>' + pctSteady + '%</em>.';
        }
    }

    /* Phases (12% / 23% / 65% da bruta total · sem horizonte cumulativo) */
    /* Fases novas: 1=líquido absoluto · 2=60% · 3=80% */
    const fullBruta = eff.bruta / eff.hMult;
    /* Líquido 2026 = bruta_2026 - fee_fixo - 20% recorrente */
    const bruta2026 = fullBruta * 0.06;
    const liq2026 = bruta2026 - eff.fee_fixo - (bruta2026 * 0.20);
    $('phase1Cap').textContent = eff.symbol + ' ' + fmt(liq2026, 2) + ' MM';
    /* Payback do fee fixo: usa o valor do estudo (DATA[cia].payback_months) que reflete o cenário real */
    const payback_m = eff.payback_months;
    const phase1Label = document.getElementById('phase1Label');
    if (phase1Label) {
        let paybackTxt;
        if (payback_m < 1.0) {
            const dias = Math.round(payback_m * 30);
            paybackTxt = isEn(STATE.cia)
                ? 'fixed fee pays back in ~' + dias + ' days'
                : 'fee fixo se paga em ~' + dias + ' dias';
        } else {
            paybackTxt = isEn(STATE.cia)
                ? 'fixed fee pays back in ~' + fmt(payback_m, 1) + ' months'
                : 'fee fixo se paga em ~' + fmt(payback_m, 1) + ' meses';
        }
        phase1Label.textContent = paybackTxt;
    }
    /* Fase 2 (pico/window) e Fase 3 (steady): usam % reais por cia do estudo */
    $('phase2Cap').textContent = (eff.liq_2027_pct || 60) + '%';
    $('phase3Cap').textContent = (eff.liq_steady_pct || 80) + '%';

    /* Foco e visão (body attributes) */
    if (STATE.focus !== 'all') document.body.setAttribute('data-focus', STATE.focus);
    else document.body.removeAttribute('data-focus');

    if (STATE.view !== 'full') document.body.setAttribute('data-view', STATE.view);
    else document.body.removeAttribute('data-view');

    /* Filter pills active state */
    document.querySelectorAll('.filter-pill').forEach(p => {
        const grp = p.parentElement.dataset.group;
        const v = p.dataset.val;
        p.classList.toggle('active', STATE[grp] === v);
    });

    /* Hub pills update dinâmico baseado em cia */
    rebuildHubPills(eff);
    if (typeof populateSimAircraft === 'function') {
        populateSimAircraft();
        autoFillQav();
        calculateSim();
    }

    /* Contador "+ Filtros" e reset visibility */
    updateFilterCounters();

    /* Nav state */
    document.querySelectorAll('.rail-progress-dot').forEach((d, i) => {
        d.classList.toggle('active', (i+1) === STATE.slide);
    });
    document.querySelectorAll('.slide').forEach(s => {
        s.classList.toggle('active', parseInt(s.dataset.slide) === STATE.slide);
    });
    $('slideLabel').textContent = STATE.slide + ' / 5';
    document.getElementById('navPrev').classList.toggle('disabled', STATE.slide === 1);
    document.getElementById('navNext').classList.toggle('disabled', STATE.slide === 5);

    persistState();
    if (typeof refreshSimForCia === "function") refreshSimForCia();
    if (typeof renderCtaSteps === "function") renderCtaSteps();
}

/* =====================================================================
   HUB PILLS DINÂMICAS
   ===================================================================== */
function rebuildHubPills(eff){
    const container = document.getElementById('hubPills');
    if (!container) return;
    const hubs = eff.hubs || [];
    /* Reset hub se não está mais disponível */
    if (STATE.hub !== 'all' && !hubs.includes(STATE.hub)) STATE.hub = 'all';

    container.innerHTML = '';
    const allBtn = document.createElement('button');
    allBtn.className = 'filter-pill' + (STATE.hub === 'all' ? ' active' : '');
    allBtn.dataset.val = 'all';
    allBtn.textContent = 'Todos';
    container.appendChild(allBtn);

    hubs.forEach(h => {
        const btn = document.createElement('button');
        btn.className = 'filter-pill' + (STATE.hub === h ? ' active' : '');
        btn.dataset.val = h;
        btn.textContent = h;
        container.appendChild(btn);
    });

    /* Re-bind listeners */
    container.querySelectorAll('.filter-pill').forEach(p => {
        p.addEventListener('click', (e) => {
            e.stopPropagation();
            handleFilterPill(p);
        });
    });
}

/* =====================================================================
   CONTADOR DE FILTROS ATIVOS + RESET BUTTON
   ===================================================================== */
function countActiveFilters(){
    let count = 0;
    /* Os 4 do painel "+Filtros" */
    if (STATE.focus !== DEFAULTS.focus) count++;
    if (STATE.view !== DEFAULTS.view) count++;
    if (STATE.aircraft !== DEFAULTS.aircraft) count++;
    if (STATE.hub !== DEFAULTS.hub) count++;
    return count;
}

function countAllActiveFilters(){
    /* Inclui rail (horizon, scenario, currency) + painel */
    let count = countActiveFilters();
    if (STATE.horizon !== DEFAULTS.horizon) count++;
    if (STATE.scenario !== DEFAULTS.scenario) count++;
    if (STATE.currency !== DEFAULTS.currency) count++;
    return count;
}

function updateFilterCounters(){
    const moreCount = countActiveFilters();
    const moreCountEl = document.getElementById('moreCount');
    moreCountEl.textContent = moreCount;
    moreCountEl.classList.toggle('zero', moreCount === 0);

    const allCount = countAllActiveFilters();
    document.getElementById('railReset').classList.toggle('hidden', allCount === 0);
}

/* =====================================================================
   RESET FILTERS
   ===================================================================== */
function resetAllFilters(){
    STATE.horizon = '6Y';
    STATE.scenario = 'base';
    STATE.currency = 'native';
    STATE.focus = 'all';
    STATE.view = 'full';
    STATE.aircraft = 'all';
    STATE.hub = 'all';
    renderAll();
}

/* =====================================================================
   FILTER PILL HANDLER (painel "+ filtros")
   ===================================================================== */
function handleFilterPill(pill){
    const grp = pill.parentElement.dataset.group;
    const v = pill.dataset.val;
    if (!grp || v === undefined) return;
    STATE[grp] = v;
    renderAll();
}

/* =====================================================================
   AUDIT PANEL CONTENT
   ===================================================================== */
