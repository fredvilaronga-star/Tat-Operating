/* =====================================================================
   STATE
   ===================================================================== */
const FX_TO_USD = { BRL: 1/5.20, USD: 1.0, EUR: 1/0.93 };
const FX_FROM_USD = { BRL: 5.20, USD: 1.0, EUR: 0.93 };
const CCY_SYMBOL = { BRL:'R$', USD:'US$', EUR:'€' };

const SCENARIO_DELTA = { bear: -0.50, base: 0, bull: 0.75 };
const HORIZON_MULT = { '6Y': 1.0, '3Y': 0.5, '1Y': 1/6 };
const HORIZON_LABEL = { '6Y': '6 anos', '3Y': '3 anos', '1Y': '1 ano' };
const HORIZON_LABEL_EN = { '6Y': '6 years', '3Y': '3 years', '1Y': '1 year' };
const AIRCRAFT_MULT = { all: 1.0, narrow: 0.55, wide: 0.40, regional: 0.18 };
const AIRCRAFT_LABEL = { all: null, narrow: 'narrow-body', wide: 'wide-body', regional: 'regional' };

