function renderCtaSteps() {
    const cia = (typeof selectedCias !== 'undefined' && selectedCias.length >= 1) ? selectedCias[0] : 'GOL';
    const data = CTA_STEPS_BY_CIA[cia] || CTA_STEPS_BY_CIA['GOL'];
    const titleEl = document.querySelector('.cta-hero-title');
    if (titleEl) titleEl.innerHTML = data.title;
    for (let i = 1; i <= 4; i++) {
        const stepData = data['step' + i];
        if (!stepData) continue;
        const tEl = document.getElementById('ctaStep' + i + 'Title');
        const pEl = document.getElementById('ctaStep' + i + 'Period');
        const bEl = document.getElementById('ctaStep' + i + 'Body');
        if (tEl) tEl.textContent = stepData.title;
        if (pEl) pEl.textContent = stepData.period;
        if (bEl) bEl.innerHTML = stepData.body;
    }
}

