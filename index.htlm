<!-- ============ MARKET / QAV ============ -->
<section class="market-section" id="market" data-section-name="market">
    <div class="market-inner">
        <div class="section-header">
            <div class="section-number">02</div>
            <div class="section-title-block">
                <div class="eyebrow">Cenário Macro · Maio 2026</div>
                <h2>Preços <em>QAV</em><br>nos 3 hubs operacionais</h2>
                <p class="lede">
                    Pós-fechamento do Estreito de Ormuz (28 fev/2026), os preços de jet fuel 
                    explodiram em mercados europeu e brasileiro. Refino local em Abu Dhabi protege 
                    parcialmente o hub de Etihad. Dados de fontes primárias oficiais.
                </p>
            </div>
        </div>
        
        <div class="market-grid">
            <div class="hub-card">
                <div class="hub-flag">🇧🇷</div>
                <div class="hub-name">São Paulo</div>
                <div class="hub-code">GRU · CGH</div>
                <div class="hub-price">R$ 6,40<span style="font-size:24px;color:var(--slate-400);">–6,80</span></div>
                <div class="hub-delta">▲ +100% vs fev/2026</div>
                <div class="hub-source">Fonte: Petrobras, comunicado 01/mai/2026</div>
            </div>
            
            <div class="hub-card">
                <div class="hub-flag">🇵🇹</div>
                <div class="hub-name">Lisboa</div>
                <div class="hub-code">LIS</div>
                <div class="hub-price">€ 1,20<span style="font-size:24px;color:var(--slate-400);">–1,30</span></div>
                <div class="hub-delta">▲ +101% vs 2025</div>
                <div class="hub-source">Fonte: IATA Jet Fuel Monitor, semana 01/mai/2026 (US$ 181/bbl)</div>
            </div>
            
            <div class="hub-card">
                <div class="hub-flag">🇦🇪</div>
                <div class="hub-name">Abu Dhabi</div>
                <div class="hub-code">AUH</div>
                <div class="hub-price">US$ 1,15<span style="font-size:24px;color:var(--slate-400);">–1,25</span></div>
                <div class="hub-delta">▲ +135% (Murban)</div>
                <div class="hub-source">Fonte: ADNOC OSP, divulgação 28/abr/2026</div>
            </div>
        </div>
        
        <!-- Comparativo Original vs Maio/26 -->
        <div class="comparison-table">
            <table>
                <thead>
                    <tr>
                        <th>Companhia</th>
                        <th>Estudo Original 6Y</th>
                        <th>Cenário Maio/26 6Y</th>
                        <th>Δ %</th>
                        <th>TAT Recebe</th>
                        <th>Cia Retém</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>GOL</td>
                        <td>R$ 180,19 MM</td>
                        <td>R$ 183,14 MM</td>
                        <td class="pos">+1,6%</td>
                        <td>R$ 35,33 MM</td>
                        <td class="highlight">R$ 149,01 MM</td>
                    </tr>
                    <tr>
                        <td>Azul</td>
                        <td>R$ 96,11 MM</td>
                        <td>R$ 97,71 MM</td>
                        <td class="pos">+1,7%</td>
                        <td>R$ 19,13 MM</td>
                        <td class="highlight">R$ 79,48 MM</td>
                    </tr>
                    <tr>
                        <td>TAP</td>
                        <td>€ 13,88 MM</td>
                        <td>€ 15,38 MM</td>
                        <td class="pos">+10,8%</td>
                        <td>€ 3,20 MM</td>
                        <td class="highlight">€ 12,42 MM</td>
                    </tr>
                    <tr>
                        <td>Etihad</td>
                        <td>US$ 35,41 MM</td>
                        <td>US$ 36,81 MM</td>
                        <td class="pos">+4,0%</td>
                        <td>US$ 9,01 MM</td>
                        <td class="highlight">US$ 28,00 MM</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</section>

<!-- ============ SENSIBILIDADE ============ -->
<section class="sensitivity-section" id="sensitivity" data-section-name="sensitivity">
    <div class="sensitivity-inner">
        <div class="sensitivity-header">
            <div class="eyebrow" style="font-family: var(--font-mono); font-size: 11px; color: var(--gold); letter-spacing: 3px; text-transform: uppercase; margin-bottom: 16px;">03 · O hedge implícito</div>
            <h2>Sensibilidade ao <em>QAV</em></h2>
            <p class="lede">
                Cada centavo importa. Para qualquer variação de preço do QAV, a economia bruta varia 
                proporcionalmente. O programa funciona como hedge automático: se QAV sobe, captura mais; 
                se cai, segue positivo. Downside zero.
            </p>
        </div>
        
        <div class="sensitivity-control">
            <div class="control-row">
                <div class="control-group">
                    <label>ΔQAV Simulado</label>
                    <input type="number" id="deltaInput" class="delta-input" value="0.05" step="0.01" min="0" max="2">
                </div>
                <div class="control-group">
                    <label>Slider · 0 a 2,00</label>
                    <input type="range" id="deltaSlider" class="delta-slider" min="0" max="2" step="0.01" value="0.05">
                </div>
                <div class="control-group">
                    <label>Sinal</label>
                    <div class="sign-toggle">
                        <button class="sign-btn active" data-sign="+">+ Alta</button>
                        <button class="sign-btn" data-sign="-">− Queda</button>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="sensitivity-grid">
            <!-- GOL -->
            <div class="sens-card" data-cia="GOL" data-sym="R$">
                <div class="sens-card-header">
                    <div class="sens-card-name">GOL</div>
                    <div class="sens-card-currency">BRL</div>
                </div>
                <table class="sens-table">
                    <thead>
                        <tr>
                            <th>Ano</th>
                            <th>QAV (ML)</th>
                            <th>Δ Bruta</th>
                            <th>Δ TAT</th>
                            <th class="net-col">Δ Cia Líq</th>
                        </tr>
                    </thead>
                    <tbody id="tbody-GOL"></tbody>
                </table>
            </div>
            
            <!-- AZUL -->
            <div class="sens-card" data-cia="Azul" data-sym="R$">
                <div class="sens-card-header">
                    <div class="sens-card-name">Azul</div>
                    <div class="sens-card-currency">BRL</div>
                </div>
                <table class="sens-table">
                    <thead>
                        <tr>
                            <th>Ano</th>
                            <th>QAV (ML)</th>
                            <th>Δ Bruta</th>
                            <th>Δ TAT</th>
                            <th class="net-col">Δ Cia Líq</th>
                        </tr>
                    </thead>
                    <tbody id="tbody-Azul"></tbody>
                </table>
            </div>
            
            <!-- TAP -->
            <div class="sens-card" data-cia="TAP" data-sym="€">
                <div class="sens-card-header">
                    <div class="sens-card-name">TAP</div>
                    <div class="sens-card-currency">EUR</div>
                </div>
                <table class="sens-table">
                    <thead>
                        <tr>
                            <th>Ano</th>
                            <th>QAV (ML)</th>
                            <th>Δ Bruta</th>
                            <th>Δ TAT</th>
                            <th class="net-col">Δ Cia Líq</th>
                        </tr>
                    </thead>
                    <tbody id="tbody-TAP"></tbody>
                </table>
            </div>
            
            <!-- ETIHAD -->
            <div class="sens-card" data-cia="Etihad" data-sym="US$">
                <div class="sens-card-header">
                    <div class="sens-card-name">Etihad</div>
                    <div class="sens-card-currency">USD</div>
                </div>
                <table class="sens-table">
                    <thead>
                        <tr>
                            <th>Ano</th>
                            <th>QAV (ML)</th>
                            <th>Δ Bruta</th>
                            <th>Δ TAT</th>
                            <th class="net-col">Δ Cia Líq</th>
                        </tr>
                    </thead>
                    <tbody id="tbody-Etihad"></tbody>
                </table>
            </div>
        </div>
        
        <!-- Escala -->
        <div class="scale-card">
            <div class="scale-header">Escala de Sensibilidade · Bruta Acumulada 6Y</div>
            <table class="scale-table">
                <thead>
                    <tr>
                        <th>Companhia</th>
                        <th>Δ 0,05</th>
                        <th>Δ 0,10</th>
                        <th>Δ 0,20</th>
                        <th>Δ 0,50</th>
                    </tr>
