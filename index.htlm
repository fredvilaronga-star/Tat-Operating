function getCurrentCiaForSim() {
    return (typeof selectedCias !== 'undefined' && selectedCias.length >= 1) ? selectedCias[0] : 'GOL';
}


function populateSimYearChips() {
    const cia = getCurrentCiaForSim();
    const container = document.getElementById('simYearChips');
    if (!container) return;
    const flights = FLIGHTS_BY_YEAR[cia] || FLIGHTS_BY_YEAR['GOL'];
    const isPartial = PARTIAL_2026[cia];
    const _enY = isEn(cia);
    container.innerHTML = '';
    [2026, 2027, 2028, 2029, 2030, 2031].forEach(yr => {
        const chip = document.createElement('div');
        const partialClass = (yr === 2026 && isPartial) ? ' partial-2026' : '';
        chip.className = 'sim-year-chip' + (selectedSimYears.includes(yr) ? ' active' : '') + partialClass;
        const voos = flights[yr] || 0;
        const formatted = voos >= 1000
            ? Math.round(voos/1000) + (_enY ? 'k flights' : 'k voos')
            : voos + (_enY ? ' flights' : ' voos');
        chip.innerHTML = '<span class="yr">' + yr + '</span><span class="vc">' + formatted + '</span>';
        chip.addEventListener('click', () => {
            const idx = selectedSimYears.indexOf(yr);
            if (idx >= 0) {
                if (selectedSimYears.length > 1) selectedSimYears.splice(idx, 1);
            } else {
                selectedSimYears.push(yr);
                selectedSimYears.sort();
            }
            populateSimYearChips();
            calculateSim();
        });
        container.appendChild(chip);
    });
    /* Update meta */
    const meta = document.getElementById('simYearsMeta');
    if (meta) {
        const totalVoos = selectedSimYears.reduce((s, y) => s + (flights[y] || 0), 0);
        const partial2026Selected = selectedSimYears.includes(2026) && isPartial;
        const ciaPartial = cia === 'TAP' || cia === 'Etihad' || cia === 'AFKLM' ? (_enY ? 'Nov-Dec' : 'Nov-Dez') : 'Set-Dez';
        const _locY = _enY ? 'en-US' : 'pt-BR';
        meta.textContent = _enY
            ? (selectedSimYears.length + ' year(s) · total ' + totalVoos.toLocaleString(_locY) + ' flights' +
               (partial2026Selected ? ' · *2026 = ' + ciaPartial + ' only (partial)' : ''))
            : (selectedSimYears.length + ' ano(s) · total ' + totalVoos.toLocaleString('pt-BR') + ' voos' +
               (partial2026Selected ? ' · *2026 = ' + ciaPartial + ' apenas (parcial)' : ''));
    }
}

function populateSimBlock() {
    const sel = document.getElementById('simBlock');
    if (!sel) return;
    const cia = getCurrentCiaForSim();
    const bands = BANDS_BY_CIA[cia] || BANDS_BY_CIA['GOL'];
    const _enB = isEn(cia);
    const prev = sel.value;
    sel.innerHTML = '';
    bands.forEach((b, i) => {
        const opt = document.createElement('option');
        opt.value = i;
        const label = _enB && b.label_en ? b.label_en : b.label;
        opt.textContent = label + ' · ' + b.pct.toFixed(1) + (_enB ? '% of network' : '% da rede');
        sel.appendChild(opt);
    });
    if (prev !== '' && bands[parseInt(prev)]) sel.value = prev;
    else sel.value = '0';
}

function populateSimAircraft() {
    const sel = document.getElementById('simAircraft');
    if (!sel) return;
    const cia = getCurrentCiaForSim();
    const list = AIRCRAFT_BY_CIA[cia] || [];
    const prev = sel.value;
    sel.innerHTML = '';

    /* Opção "Todas as frotas" no topo */
    const optAll = document.createElement('option');
    optAll.value = 'ALL';
    optAll.textContent = (isEn(getCurrentCiaForSim())
        ? '★ All fleets (consolidated · 2027 annual saving)'
        : '★ Todas as frotas (consolidado · saving anual 2027)');
    sel.appendChild(optAll);

    list.forEach((ac, i) => {
        const opt = document.createElement('option');
        opt.value = i;
        opt.textContent = ac.nome + ' · ' + ac.tanque + 'L · block ' + ac.block_time.toFixed(1) + 'h';
        sel.appendChild(opt);
    });

    /* Default = consolidado */
    if (prev === 'ALL') sel.value = 'ALL';
    else if (prev !== '' && list[prev]) sel.value = prev;
    else sel.value = 'ALL';

    autoFillFromAircraft();
}

function autoFillFromAircraft() {
    const cia = getCurrentCiaForSim();
    const sel = document.getElementById('simAircraft');
    if (!sel) return;
    const list = AIRCRAFT_BY_CIA[cia] || [];

    /* MODO CONSOLIDADO (todas as frotas) */
    if (sel.value === 'ALL') {
        const totalAc = list.reduce((s, ac) => s + (ac.qtd_frota || 0), 0);
        const totalVoos = list.reduce((s, ac) => s + (ac.voos_ano || 0), 0);
        const totalEvit = list.reduce((s, ac) => s + ((ac.evit_voo || 0) * (ac.voos_ano || 0)), 0);
        const evitMedio = totalVoos > 0 ? totalEvit / totalVoos : 0;
        const _en = isEn(cia);
        const _loc = _en ? 'en-US' : 'pt-BR';

        document.getElementById('simAircraftMeta').textContent = _en
            ? ('Consolidated: ' + list.length + ' models · ' + totalAc + ' aircraft · ' +
               totalVoos.toLocaleString(_loc) + ' flights/year · average avoidable ' + evitMedio.toFixed(0) + 'L/flight')
            : ('Consolidado: ' + list.length + ' modelos · ' + totalAc + ' aeronaves · ' +
               totalVoos.toLocaleString('pt-BR') + ' voos/ano · evitável médio ' + evitMedio.toFixed(0) + 'L/voo');

        /* Desabilitar campos que não fazem sentido em consolidado */
        ['simTank','simBlock','simFleet','simFlights'].forEach(id => {
            const el = document.getElementById(id);
            if (el) {
                el.disabled = true;
                el.style.opacity = '0.4';
                el.style.cursor = 'not-allowed';
            }
        });

        const tankMeta = document.getElementById('simTankMeta');
        if (tankMeta) tankMeta.textContent = _en
            ? 'each aircraft uses its own ATA 38 tank (not editable in consolidated)'
            : 'cada aeronave usa seu próprio tanque ATA 38 (não editável em consolidado)';
        const blockMeta = document.getElementById('simBlockMeta');
        if (blockMeta) blockMeta.textContent = _en
            ? 'each aircraft uses its own typical block time (consolidated)'
            : 'cada aeronave usa seu próprio block time típico (consolidado)';
        const fleetMeta = document.getElementById('simFleet').nextElementSibling;
        if (fleetMeta) fleetMeta.textContent = _en
            ? ('total ' + cia + ' fleet 2027: ' + totalAc + ' aircraft (not editable)')
            : ('frota total ' + cia + ' 2027: ' + totalAc + ' aeronaves (não editável)');
        const flightsMeta = document.getElementById('simFlightsMeta');
        if (flightsMeta) flightsMeta.textContent = _en
            ? 'each model uses its own flights/year (not editable in consolidated)'
            : 'cada modelo usa seus próprios voos/ano (não editável em consolidado)';

        return;
    }

    /* MODO AERONAVE INDIVIDUAL */
    const ac = list[sel.value];
    if (!ac) return;

    /* Reabilitar campos se estavam desabilitados */
    ['simTank','simBlock','simFleet','simFlights'].forEach(id => {
        const el = document.getElementById(id);
        if (el) {
            el.disabled = false;
            el.style.opacity = '';
            el.style.cursor = '';
        }
    });

    const _en = isEn(cia);
    document.getElementById('simAircraftMeta').textContent = _en
        ? ('Tank ' + ac.tanque + 'L (ATA 38) · consumption ' + ac.consumo_voo + 'L · k_h ' + ac.k_h.toFixed(4) + (ac.note ? ' · ' + ac.note : ''))
        : ('Tanque ' + ac.tanque + 'L (ATA 38) · consumo ' + ac.consumo_voo + 'L · k_h ' + ac.k_h.toFixed(4) + (ac.note ? ' · ' + ac.note : ''));

    /* Default do tanque na aeronave selecionada */
    document.getElementById('simTank').value = ac.tanque;
    document.getElementById('simTankMeta').textContent = _en
        ? ('ATA 38: ' + ac.tanque + 'L · editable to simulate variation')
        : ('ATA 38: ' + ac.tanque + 'L · pode editar para simular variação');

    /* Selecionar a faixa do ESTUDO mais próxima do block desta aeronave */
    const bands = BANDS_BY_CIA[cia] || BANDS_BY_CIA['GOL'];
    const blockSel = document.getElementById('simBlock');
    let bestIdx = 0; let minDiff = Infinity;
    bands.forEach((b, i) => {
        const d = Math.abs(b.block_h - ac.block_time);
        if (d < minDiff) { minDiff = d; bestIdx = i; }
    });
    blockSel.value = bestIdx;
    const band = bands[bestIdx];
    document.getElementById('simBlockMeta').textContent = _en
        ? ('routes: ' + band.rotas + ' · block ' + band.block_h.toFixed(2) + 'h · study avoidable: ' + band.evit_L + 'L/flight')
        : ('rotas: ' + band.rotas + ' · block ' + band.block_h.toFixed(2) + 'h · evit. estudo: ' + band.evit_L + 'L/voo');

    /* Recalcular FROTA do modelo selecionado (qtd típica daquele tipo) */
    if (ac.qtd_frota !== undefined) {
        document.getElementById('simFleet').value = ac.qtd_frota;
        const meta = document.getElementById('simFleet').nextElementSibling;
        if (meta) meta.textContent = _en
            ? ('typical count of ' + ac.nome + ' in ' + cia + ' fleet (study)')
            : ('qtd típica de ' + ac.nome + ' na frota ' + cia + ' (estudo)');
    } else if (ac.pct_frota !== undefined && STUDY_CTX[cia]) {
        const fleetTotal = STUDY_CTX[cia].fleet_2027;
        const qtd = Math.max(1, Math.round(fleetTotal * (ac.pct_frota / 100)));
        document.getElementById('simFleet').value = qtd;
    }

    /* Voos/mês por AERONAVE = (voos_ano da frota desse modelo ÷ qtd dessa frota) ÷ 12 */
    if (ac.voos_ano && ac.qtd_frota) {
        const voos_ano_por_ac = ac.voos_ano / ac.qtd_frota;
        const voos_mes = Math.round(voos_ano_por_ac / 12);
        document.getElementById('simFlights').value = voos_mes;
        const _loc = _en ? 'en-US' : 'pt-BR';
        document.getElementById('simFlightsMeta').textContent = _en
            ? ('study: ' + ac.voos_ano.toLocaleString(_loc) + ' flights/year for ' + ac.nome + ' fleet ÷ ' + ac.qtd_frota + ' aircraft ÷ 12 = ' + voos_mes + '/month')
            : ('estudo: ' + ac.voos_ano.toLocaleString('pt-BR') + ' voos/ano da frota ' + ac.nome + ' ÷ ' + ac.qtd_frota + ' aeronaves ÷ 12 = ' + voos_mes + '/mês');
    }
}

function autoFillQav() {
    const cia = getCurrentCiaForSim();
    const d = DATA[cia];
    if (!d) return;
    const _en = isEn(cia);
    const qavInput = document.getElementById('simQav');
    if (qavInput) {
        qavInput.value = d.qav_baseline.toFixed(2);
        const meta = document.getElementById('simQavMeta');
        if (meta) meta.textContent = _en
            ? (d.symbol + ' per litre · baseline ' + cia + ' study (' + d.qav_hub_default + ')')
            : (d.symbol + ' por litro · baseline estudo ' + cia + ' (' + d.qav_hub_default + ')');
    }
    /* Load Factor default da cia */
    const lfInput = document.getElementById('simLF');
    if (lfInput && STUDY_CTX[cia]) {
        lfInput.value = STUDY_CTX[cia].load_factor.toFixed(1);
        const lfMeta = document.getElementById('simLFMeta');
        if (lfMeta) lfMeta.textContent = _en
            ? (cia + ' 2027: ' + STUDY_CTX[cia].load_factor.toFixed(1) + '% (final study)')
            : (cia + ' 2027: ' + STUDY_CTX[cia].load_factor.toFixed(1) + '% (estudo final)');
    }
}

function calculateSim() {
    const cia = getCurrentCiaForSim();
    const list = AIRCRAFT_BY_CIA[cia] || [];
    const sel = document.getElementById('simAircraft');
    if (!sel || !list.length) return;

    const qav = parseFloat(document.getElementById('simQav').value) || 0;
    const lfInput = parseFloat(document.getElementById('simLF').value) || 80;
    const lf = lfInput / 100;
    const sym = DATA[cia] ? DATA[cia].symbol : 'R$';

    /* Calcular total de voos nos anos selecionados (da cia inteira) */
    const flightsPerYear = FLIGHTS_BY_YEAR[cia] || FLIGHTS_BY_YEAR['GOL'];
    const ciaVoos2027 = flightsPerYear[2027] || 1;
    let totalVoosCiaSelected = 0;
    selectedSimYears.forEach(y => { totalVoosCiaSelected += (flightsPerYear[y] || 0); });

    /* Multiplicador: quantas vezes o "ano de 2027" os anos selecionados representam */
    const yearMultiplier = totalVoosCiaSelected / ciaVoos2027;

    /* Update label dinâmico */
    const labelEl = document.getElementById('simResultLabel');
    if (labelEl) {
        const anos = selectedSimYears.length;
        const _en = isEn(cia);
        let labelTxt;
        if (_en) {
            if (anos === 1) labelTxt = 'GROSS savings · ' + selectedSimYears[0];
            else if (anos === 6) labelTxt = 'GROSS savings · 6 years (Sep/26–Dec/31)';
            else labelTxt = 'GROSS savings · ' + anos + ' years selected';
        } else {
            if (anos === 1) labelTxt = 'Economia BRUTA · ' + selectedSimYears[0];
            else if (anos === 6) labelTxt = 'Economia BRUTA · 6 anos (Set/26–Dez/31)';
            else labelTxt = 'Economia BRUTA · ' + anos + ' anos selecionados';
        }
        labelEl.textContent = labelTxt;
    }

    /* MODO CONSOLIDADO: soma todas as aeronaves */
    if (sel.value === 'ALL') {
        let econTotal = 0;
        let aguaTotalL = 0;
        let qavTotalL = 0;
        let voosTotal = 0;
        let acTotal = 0;

        list.forEach(ac => {
            const tanque = ac.tanque;
            const cons = ac.consumo_voo || 0;
            const reman = ac.remanescente || 0;
            const block = ac.block_time;
            const voos_ano_modelo_2027 = ac.voos_ano || 0;
            /* Escala os voos do modelo para os anos selecionados */
            const voos_modelo_periodo = voos_ano_modelo_2027 * yearMultiplier;
            const evit_voo = ac.evit_voo;

            const aguaExc = evit_voo !== undefined
                ? evit_voo
                : Math.max(0, tanque - cons - reman);

            const econModelo = aguaExc * ac.k_h * block * qav * voos_modelo_periodo * lf;
            econTotal += econModelo;

            aguaTotalL += aguaExc * voos_modelo_periodo;
            qavTotalL += aguaExc * ac.k_h * block * voos_modelo_periodo;
            voosTotal += voos_modelo_periodo;
            acTotal += (ac.qtd_frota || 0);
        });

        const econAnoMedio = selectedSimYears.length > 0 ? econTotal / selectedSimYears.length : 0;
        const econVooMedio = voosTotal > 0 ? econTotal / voosTotal : 0;
        const aguaMediaPorVoo = voosTotal > 0 ? aguaTotalL / voosTotal : 0;
        const qavMedioPorVoo = voosTotal > 0 ? qavTotalL / voosTotal : 0;

        document.getElementById('simCcy').textContent = sym;
        document.getElementById('simResult').textContent = fmt(econTotal / 1e6, 2);
        const _enRes = isEn(cia);
        const _locRes = _enRes ? 'en-US' : 'pt-BR';
        document.getElementById('simResultSub').textContent = _enRes
            ? ('consolidated · ' + acTotal + ' aircraft · ' + Math.round(voosTotal).toLocaleString(_locRes) + ' flights · ' +
               sym + ' ' + fmt(econAnoMedio / 1e6, 2) + ' MM/avg year · ' + sym + ' ' + fmt(econVooMedio, 0) + '/flight')
            : ('consolidado · ' + acTotal + ' aeronaves · ' + Math.round(voosTotal).toLocaleString('pt-BR') + ' voos · ' +
               sym + ' ' + fmt(econAnoMedio / 1e6, 2) + ' MM/ano médio · ' + sym + ' ' + fmt(econVooMedio, 0) + '/voo');
        document.getElementById('simWater').textContent = fmt(aguaMediaPorVoo, 0);
        document.getElementById('simFuel').textContent = fmt(qavMedioPorVoo, 1);
        document.getElementById('simNetCcy').textContent = sym;
        document.getElementById('simNet').textContent = fmt(econTotal * 0.80 / 1e6, 2);

        return;
    }

    /* MODO AERONAVE INDIVIDUAL */
    const ac = list[sel.value];
    if (!ac) return;
    const bands = BANDS_BY_CIA[cia] || BANDS_BY_CIA['GOL'];
    const bandIdx = parseInt(document.getElementById('simBlock').value) || 0;
    const band = bands[bandIdx];
    if (!band) return;

    const tankInput = parseFloat(document.getElementById('simTank').value) || ac.tanque;

    /* Água excedente = min(evit do estudo, tanque editado - consumo - remanescente) */
    const evitFromTank = Math.max(0, tankInput - (ac.consumo_voo || 0) - (ac.remanescente || 0));
    const aguaExc = Math.min(band.evit_L, evitFromTank);

    const block = band.block_h;
    const econVoo = aguaExc * ac.k_h * block * qav;

    /* Voos da aeronave nos anos selecionados (escala pelo multiplicador) */
    const voos_modelo_periodo = (ac.voos_ano || 0) * yearMultiplier;
    const econTotal = econVoo * voos_modelo_periodo * lf;
    const econAnoMedio = selectedSimYears.length > 0 ? econTotal / selectedSimYears.length : 0;
    const qavL = aguaExc * ac.k_h * block;

    document.getElementById('simCcy').textContent = sym;
    document.getElementById('simResult').textContent = fmt(econTotal / 1e6, 2);
    const _enResI = isEn(cia);
    const _locResI = _enResI ? 'en-US' : 'pt-BR';
    document.getElementById('simResultSub').textContent = _enResI
        ? (Math.round(voos_modelo_periodo).toLocaleString(_locResI) + ' flights · ' +
           sym + ' ' + fmt(econAnoMedio / 1e6, 2) + ' MM/avg year · ' + sym + ' ' + fmt(econVoo, 0) + '/flight')
        : (Math.round(voos_modelo_periodo).toLocaleString('pt-BR') + ' voos · ' +
           sym + ' ' + fmt(econAnoMedio / 1e6, 2) + ' MM/ano médio · ' + sym + ' ' + fmt(econVoo, 0) + '/voo');
    document.getElementById('simWater').textContent = fmt(aguaExc, 0);
    document.getElementById('simFuel').textContent = fmt(qavL, 1);
    document.getElementById('simNetCcy').textContent = sym;
    document.getElementById('simNet').textContent = fmt(econTotal * 0.80 / 1e6, 2);

    const blockMeta = document.getElementById('simBlockMeta');
    if (blockMeta) blockMeta.textContent = isEn(cia)
        ? ('routes: ' + band.rotas + ' · block ' + band.block_h.toFixed(2) + 'h · avoidable: ' + band.evit_L + 'L/flight')
        : ('rotas: ' + band.rotas + ' · block ' + band.block_h.toFixed(2) + 'h · evit: ' + band.evit_L + 'L/voo');
}

function initSim() {
    const sel = document.getElementById('simAircraft');
    if (!sel) return;
    populateSimBlock();
    populateSimAircraft();
    populateSimYearChips();
    autoFillQav();
    autoFillFromAircraft();
    calculateSim();
    sel.addEventListener('change', () => { autoFillFromAircraft(); calculateSim(); });
    ['simQav','simFleet','simFlights','simTank','simLF'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.addEventListener('input', calculateSim);
    });
    const blkEl = document.getElementById('simBlock');
    if (blkEl) blkEl.addEventListener('change', calculateSim);
}

/* Re-populate quando cia muda */
function refreshSimForCia() {
    populateSimBlock();
    populateSimAircraft();
    populateSimYearChips();
    autoFillQav();
    autoFillFromAircraft();
    calculateSim();
}


document.addEventListener('DOMContentLoaded', () => {
    /* Welcome cards */
    document.querySelectorAll('[data-welcome-cia]').forEach(card => {
        card.addEventListener('click', () => {
            selectedCias = [card.dataset.welcomeCia];
            STATE.cia = card.dataset.welcomeCia;
            STATE.slide = 1;
            renderAll();
        });
    });

    /* Rail filter triggers */
    document.querySelectorAll('.rail-filter').forEach(f => {
        f.addEventListener('click', (e) => {
            if (e.target.closest('.rail-menu-item')) return;
            e.stopPropagation();
            toggleRailMenu(f);
        });
    });

    /* Rail menu items */
    document.querySelectorAll('.rail-menu-item').forEach(item => {
        item.addEventListener('click', (e) => {
            e.stopPropagation();
            /* Multi-cia: toggle no array */
            if (item.dataset.ciaMulti !== undefined){
                const c = item.dataset.ciaMulti;
                const idx = selectedCias.indexOf(c);
                if (idx >= 0) selectedCias.splice(idx, 1);
                else selectedCias.push(c);
                if (selectedCias.length > 0) STATE.cia = selectedCias[0];
                /* NÃO fechar menu — usuário pode marcar várias */
                renderAll();
                return;
            }
            if (item.dataset.horizon)  STATE.horizon = item.dataset.horizon;
            if (item.dataset.scenario) STATE.scenario = item.dataset.scenario;
            if (item.dataset.currency) STATE.currency = item.dataset.currency;
            closeAllRailMenus();
            renderAll();
        });
    });
    
    /* Botões Todas / Limpar */
    const allBtn = document.getElementById('ciaSelectAll');
    if (allBtn) allBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        selectedCias = ['GOL','Azul','TAP','Etihad','AFKLM','United','Copa','American','Avianca'];
        STATE.cia = selectedCias[0];
        renderAll();
    });
    const noneBtn = document.getElementById('ciaSelectNone');
    if (noneBtn) noneBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        selectedCias = [];
        renderAll();
    });

    /* + Filtros toggle */
    document.getElementById('moreToggle').addEventListener('click', (e) => {
        e.stopPropagation();
        toggleMorePanel();
    });

    /* Filter pills (no painel) */
    document.querySelectorAll('.filter-pill').forEach(p => {
        p.addEventListener('click', (e) => {
            e.stopPropagation();
            handleFilterPill(p);
        });
    });

    /* Reset button */
    document.getElementById('railReset').addEventListener('click', (e) => {
        e.stopPropagation();
        resetAllFilters();
    });

    /* Click fora fecha menus do rail */
    document.addEventListener('click', () => closeAllRailMenus());

    /* Audit triggers */
    document.querySelectorAll('[data-audit]').forEach(el => {
        el.addEventListener('click', (e) => {
            e.stopPropagation();
            const key = el.dataset.audit;
            if (key) openAudit(key);
        });
    });

    document.getElementById('auditClose').addEventListener('click', closeAudit);
    document.getElementById('auditBackdrop').addEventListener('click', closeAudit);

    /* Nav */
    document.getElementById('navPrev').addEventListener('click', () => goToSlide(STATE.slide - 1));
    document.getElementById('navNext').addEventListener('click', () => goToSlide(STATE.slide + 1));

    /* Progress dots */
    document.querySelectorAll('.rail-progress-dot').forEach(dot => {
        dot.addEventListener('click', (e) => {
            e.stopPropagation();
            goToSlide(parseInt(dot.dataset.goto));
        });
    });

    /* Keyboard */
    document.addEventListener('keydown', (e) => {
        if (e.target.tagName === 'INPUT' || e.target.tagName === 'SELECT') return;
        if (e.key === 'Escape'){ closeAudit(); closeAllRailMenus(); return; }
        if (selectedCias.length === 0) return;
        if (e.key === 'ArrowRight' || e.key === ' '){ e.preventDefault(); goToSlide(STATE.slide + 1); }
        else if (e.key === 'ArrowLeft'){ e.preventDefault(); goToSlide(STATE.slide - 1); }
        else if (e.key >= '1' && e.key <= '5'){ goToSlide(parseInt(e.key)); }
    });

    /* Boot */
    renderAll();
    initSim();
    if (typeof renderCtaSteps === 'function') renderCtaSteps();
});



</script>
</body>
</html>
